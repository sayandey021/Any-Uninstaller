<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:junk="using:UninstallTools.Junk"
        xmlns:dialogs="using:AnyUninstaller.Avalonia.Views.Dialogs"
        x:Class="AnyUninstaller.Avalonia.Views.Dialogs.ProcessLockDialog"
        x:DataType="dialogs:ProcessLockDialog"
        Title="Applications In Use — Any Uninstaller"
        Icon="/Assets/logo.ico"
        Width="700" Height="440"
        MinWidth="580" MinHeight="360"
        Background="{DynamicResource AppBgBrush}"
        WindowStartupLocation="CenterOwner">

    <DockPanel LastChildFill="True" Margin="16">
        <!-- Header Info Card -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                        Background="#25171c" BorderBrush="#f85149" BorderThickness="1.5"
                        VerticalAlignment="Center" Margin="0,0,14,0">
                    <PathIcon Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                              Width="20" Height="20" Foreground="#f85149"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Applications In Use Preventing Deletion" FontSize="15" FontWeight="Bold" Foreground="#f85149"/>
                    <TextBlock Text="The following applications are locking folders or files scheduled for removal. Any Uninstaller will close them to delete the items and automatically restart them (including Windows Explorer) afterwards."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Action Bar -->
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" x:Name="SummaryTextBlock" Text="1 process locking folder" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                
                <Button Grid.Column="1" Content="Skip Locked Items" Classes="toolbar"
                        Click="OnSkipClick" ToolTip.Tip="Deselect locked folders and delete only unlocked items" Margin="0,0,8,0"/>
                
                <Button Grid.Column="2" Content="Cancel" Classes="toolbar" Width="80"
                        Click="OnCancelClick" Margin="0,0,8,0"/>

                <Button Grid.Column="3" x:Name="EndProcessButton" Content="Close, Delete &amp; Restart" Classes="action-uninstall"
                        Click="OnEndProcessesClick" ToolTip.Tip="Close selected locking applications, delete the locked items, and automatically restart them (including Windows Explorer)"/>
            </Grid>
        </Border>

        <!-- Process List Card -->
        <Border Classes="card" Padding="4">
            <DataGrid x:Name="ProcessDataGrid"
                      x:DataType="junk:LockingProcessInfo"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      IsReadOnly="False"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="40"/>
                    
                    <DataGridTemplateColumn Header="Application / Process" Width="1.5*" MinWidth="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="junk:LockingProcessInfo">
                                <StackPanel VerticalAlignment="Center" Margin="6,2">
                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ProcessDetails}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Action on Delete" Width="1.4*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="junk:LockingProcessInfo">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0">
                                    <CheckBox IsChecked="{Binding ShouldRestart, Mode=TwoWay}"
                                              IsEnabled="{Binding CanRestart}"
                                              VerticalAlignment="Center" Margin="0"/>
                                    <TextBlock Text="{Binding RestartStatusText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="Whether this application will be restarted after deletion"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Locked Path" Width="1.8*" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="junk:LockingProcessInfo">
                                <TextBlock Text="{Binding LockedPath}" VerticalAlignment="Center" Margin="6,0"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LockedPath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Executable Location" Width="1.5*" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="junk:LockingProcessInfo">
                                <TextBlock Text="{Binding ExecutablePath}" VerticalAlignment="Center" Margin="6,0"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExecutablePath}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
