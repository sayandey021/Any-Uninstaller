<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnyUninstaller.Avalonia.ViewModels"
        x:Class="AnyUninstaller.Avalonia.Views.Dialogs.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="About Any Uninstaller"
        Icon="/Assets/logo.ico"
        Width="440" Height="500"
        Background="#151D24"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.link-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E293B"/>
        </Style>
    </Window.Styles>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
            <!-- App Logo in Rounded Squircle Container -->
            <Border Width="84" Height="84" CornerRadius="20" Background="#1E293B"
                    HorizontalAlignment="Center" BoxShadow="0 4 16 0 #35000000">
                <Image Source="/Assets/logo.png" Width="68" Height="68"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- App Title -->
            <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0"/>

            <!-- Version -->
            <TextBlock Text="{Binding VersionDisplay}" FontSize="13"
                       Foreground="#7E8E9F" HorizontalAlignment="Center" Margin="0,3,0,0"/>

            <!-- Tagline / Description -->
            <TextBlock Text="{Binding Description}" FontSize="13"
                       Foreground="#7E8E9F" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="320" HorizontalAlignment="Center" Margin="0,8,0,0"/>

            <!-- Subtle Divider -->
            <Rectangle Width="64" Height="1" Fill="#2A3744" HorizontalAlignment="Center" Margin="0,18,0,18"/>

            <!-- Developer Section -->
            <TextBlock Text="{Binding DeveloperTitle}" FontSize="13"
                       Foreground="#7E8E9F" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding DeveloperName}" FontSize="16" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,14"/>

            <!-- Links -->
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <!-- LinkedIn Link -->
                <Button Classes="link-btn" Click="OnLinkedInClick" ToolTip.Tip="Open LinkedIn Profile">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="4" Background="#0A66C2" VerticalAlignment="Center">
                            <TextBlock Text="in" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <TextBlock Text="{Binding LinkedInDisplay}" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- GitHub Link -->
                <Button Classes="link-btn" Click="OnGitHubClick" ToolTip.Tip="Open GitHub Profile">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Path Data="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"
                              Fill="#38BDF8" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GitHubDisplay}" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Close Button -->
            <Button Content="Close" Classes="toolbar" HorizontalAlignment="Center" Width="90" Margin="0,18,0,0" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
